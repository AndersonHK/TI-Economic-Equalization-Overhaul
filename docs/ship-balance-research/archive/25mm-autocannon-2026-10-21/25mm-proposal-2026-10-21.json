    "hitPoints": "hp ?? (3 * internalSize)",
    "training_rate_deg_s": "270 / weaponTemplate.internalSize",
    "magazineMass_kg": "magazine * ammoMass_kg",
    "buildMass_tons": "baseWeaponMass_tons + (1 + shipMagazineMultiplier) * magazineMass_tons"
  }
